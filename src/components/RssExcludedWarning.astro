---
import type { Language } from '@lib/language'

type Props = {
  language: Language
}

const { language } = Astro.props
---

<div class="callout callout-info">
  <p class="callout-title">
    <i class="callout-icon"></i>{language.getTranslation('callout_info')}
  </p>
  <p>{language.getTranslation('rss_excluded_warning')}</p>
</div>
